DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Production uses comma-separated origins, for example:
# CORS_ALLOWED_ORIGINS=https://getneba.app,https://www.getneba.app
# CSRF_TRUSTED_ORIGINS=https://getneba.app,https://www.getneba.app
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DATABASE_URL=postgres://user:password@localhost:5432/nearwork
# REDIS_URL=redis://default:password@host:6379/0
# Real SMS provider. No development OTP bypass exists.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_ALLOWED_PREFIXES=+234
# Generate a Fernet key once, store in a secret manager, and preserve across restarts.
VERIFICATION_ENCRYPTION_KEY=
VERIFICATION_RETENTION_DAYS=30
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=neba-profile-photos
TASK_ITEM_VALUE_LIMIT=50000
# Web push is enabled only when all three VAPID values are set. Keep the private
# key in your deployment secret manager; the public key is exposed to signed-in browsers.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@getneba.app
# AI interview voice sessions. Keep the API key server-side only.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Optional. Defaults to OPENAI_TEXT_MODEL (or gpt-4.1-mini) and must support
# Responses API web search and Structured Outputs.
OPPORTUNITY_CHECK_MODEL=gpt-4.1-mini
# Comma-separated RSS, Atom, or JSON opportunity feeds. New items enter manual review.
OPPORTUNITY_FEED_URLS=https://www.afdb.org/en/vacancies/news-and-events/rss
OPPORTUNITY_FETCH_LIMIT=5
# Required to protect the scheduled opportunity fetch endpoint.
CRON_SECRET=
# Bachs payments. Start with sk_sandbox_ and the sandbox product IDs. The
# webhook endpoint is https://YOUR_API/api/billing/webhook/.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
# Optional; inferred from the key prefix when omitted.
# BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_PLUS_MONTHLY_PRODUCT_ID=
BACHS_PLUS_YEARLY_PRODUCT_ID=
BILLING_PLUS_MONTHLY_PRICE=5.00
BILLING_PLUS_YEARLY_PRICE=48.00
BILLING_PLUS_CURRENCY=USD
