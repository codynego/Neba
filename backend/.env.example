DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Production uses comma-separated origins, for example:
# CORS_ALLOWED_ORIGINS=https://getneba.app,https://www.getneba.app
# CSRF_TRUSTED_ORIGINS=https://getneba.app,https://www.getneba.app
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DATABASE_URL=postgres://user:password@localhost:5432/nearwork
# REDIS_URL=redis://default:password@host:6379/0
# Real SMS provider. No development OTP bypass exists.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_ALLOWED_PREFIXES=+234
# Generate a Fernet key once, store in a secret manager, and preserve across restarts.
VERIFICATION_ENCRYPTION_KEY=
VERIFICATION_RETENTION_DAYS=30
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=neba-profile-photos
