NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Canonical public origin; replace only when the deployment domain changes.
NEXT_PUBLIC_SITE_URL=https://getneba.app
# Production public pages index by default. Set false on staging deployments.
# Development and Vercel previews are automatically excluded from indexing.
SEO_INDEXABLE=true
# Optional Search Console HTML verification token (not the full meta tag).
GOOGLE_SITE_VERIFICATION=
# Required before public launch. Use the registered individual/company details
# responsible for GetNeba and an actively monitored legal/privacy inbox.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
